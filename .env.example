# Copy to .env and fill in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# Local MongoDB (MongoDB Community Server). For Atlas, paste your connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/brandguard_dev

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend origin allowed by CORS (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# Optional. If empty, the API runs in clearly labelled DEMO AI mode (simple heuristics, not real AI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# false = the person who submitted content cannot approve it themselves (recommended)
ALLOW_SELF_APPROVAL=false

# Password given to seeded demo users (npm run seed)
SEED_PASSWORD=replace-with-a-local-test-password
